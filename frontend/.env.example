# Frontend TravelGrin
# Copiá este archivo como .env.local para desarrollo o cargá estas variables en Vercel.

# URL pública final del frontend.
NEXT_PUBLIC_APP_URL=https://tu-frontend.vercel.app

# URL pública final del backend. El frontend usa estas variables para reenviar /api/* y auth admin.
NEXT_API_PROXY_TARGET=https://tu-backend.vercel.app
BACKEND_API_URL=https://tu-backend.vercel.app

# Debe ser exactamente el mismo valor que ADMIN_JWT_SECRET en el backend.
ADMIN_JWT_SECRET=pegá-el-mismo-secret-largo-del-backend
